# Public URLs of the Creda apps. Override locally in .env.local.
NEXT_PUBLIC_BUYER_URL=https://app.creda.sa/
NEXT_PUBLIC_SUPPLIER_REGISTER_URL=https://supplier.creda.sa/register?step=details&role=supplier

# Creda buyer API (server-side only). Used by the contact form.
CREDA_API_URL=https://api.creda.sa/api/buyer
